# Эмбеддинги: BAAI/bge-m3 (по умолчанию), intfloat/multilingual-e5-small (быстрее на слабом CPU),
# hashing (без скачивания моделей, качество ниже). После смены — python -m triage index
EMBEDDER=BAAI/bge-m3

# LLM через OpenAI-совместимый API. Если не задать — работает классификация по правилам.
# Gemini (ключ в Google AI Studio, список моделей там же):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-flash-latest
# LLM_API_KEY=ваш_ключ
# Ollama на своём компьютере (ollama pull qwen2.5:3b):
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# LLM_API_KEY=ollama

# Qdrant-сервер вместо встроенного режима — если веб-интерфейс и MCP нужны одновременно:
# QDRANT_URL=http://localhost:6333
